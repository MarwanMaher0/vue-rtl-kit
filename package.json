{
  "name": "vue-rtl-kit",
  "version": "0.1.1",
  "description": "Vue 3 + Nuxt toolkit for real RTL: direction state, logical-property utilities, and Unicode-isolated bidirectional text that stops Latin runs breaking inside Arabic.",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "rtl",
    "bidi",
    "i18n",
    "arabic",
    "hebrew",
    "direction",
    "logical-properties",
    "typescript"
  ],
  "license": "MIT",
  "author": "Marwan Maher <marwanmaher635@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarwanMaher0/vue-rtl-kit.git"
  },
  "bugs": {
    "url": "https://github.com/MarwanMaher0/vue-rtl-kit/issues"
  },
  "homepage": "https://marwanmaher0.github.io/vue-rtl-kit/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/vue-rtl-kit.cjs",
  "module": "./dist/vue-rtl-kit.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "nuxt": [
        "./dist/nuxt/module.d.ts"
      ],
      "styles.css": [
        "./dist/styles.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/vue-rtl-kit.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/vue-rtl-kit.cjs"
      }
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.js"
    },
    "./styles.css": {
      "import": {
        "types": "./dist/styles.d.ts",
        "default": "./dist/styles.css"
      },
      "require": {
        "types": "./dist/styles.d.cts",
        "default": "./dist/styles.css"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "vite build && vite build -c vite.nuxt.config.ts && tsc -p tsconfig.build.json && rollup -c rollup.dts.config.mjs && node scripts/copy-assets.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:treeshake": "node scripts/check-treeshake.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "release": "changeset publish",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "test:types": "vue-tsc --noEmit -p test/types/tsconfig.json && vue-tsc --noEmit -p test/types/tsconfig.cjs.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "play": "vite --config playground/vite.config.ts",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site",
    "docs:check": "node scripts/check-docs.mjs",
    "subset:fonts": "node scripts/subset-fonts.mjs --arabic",
    "check:fonts": "node scripts/subset-fonts.mjs --arabic --check",
    "fonts:subset": "node scripts/subset-fonts.mjs"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@nuxt/kit": "^4.6.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "~4.4.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser": "5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "nuxt": "~4.6.4",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "rollup": "^4.68.8",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.1",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  }
}
