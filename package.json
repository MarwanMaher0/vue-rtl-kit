{
  "name": "vue-rtl-kit",
  "version": "0.1.1",
  "description": "Vue 3 + Nuxt toolkit for real RTL: direction state, logical-property utilities, and Unicode-isolated bidirectional text that stops Latin runs breaking inside Arabic.",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "rtl",
    "bidi",
    "i18n",
    "arabic",
    "hebrew",
    "direction",
    "logical-properties",
    "typescript"
  ],
  "license": "MIT",
  "author": "Marwan Maher <marwanmaher635@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarwanMaher0/vue-rtl-kit.git"
  },
  "bugs": {
    "url": "https://github.com/MarwanMaher0/vue-rtl-kit/issues"
  },
  "homepage": "https://github.com/MarwanMaher0/vue-rtl-kit#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/vue-rtl-kit.cjs",
  "module": "./dist/vue-rtl-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-rtl-kit.js",
      "require": "./dist/vue-rtl-kit.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.js"
    },
    "./styles.css": "./dist/styles.css",
    "./dist/styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "vite build && vite build -c vite.nuxt.config.ts && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "play": "vite --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "@nuxt/kit": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@nuxt/kit": "^3.14.0",
    "@nuxt/schema": "^3.14.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.31.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  }
}
