{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "dist/.types",
    "types": ["node"],
    "paths": { "vue-rtl-kit": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "test", "playground"]
}
